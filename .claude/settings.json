{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git tag v*)",
      "Bash(git push origin v*)"
    ],
    "ask": [
      "Bash(git push*--force*)",
      "Bash(git push*-f*)",
      "Bash(git push*--delete*)",
      "Bash(git tag -d*)",
      "Bash(git tag -f*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git branch -D:*)",
      "Bash(npm install:*)",
      "Bash(cargo update:*)"
    ],
    "deny": [
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)"
    ]
  }
}